<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="10dp"


    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="20dp"
            android:id="@+id/titleGuideline"/>




        <TextView
            android:id="@+id/popup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="70dp"
            android:text="请输入Gift Card #:"
            android:textColor="@color/black"
            app:layout_constraintBottom_toTopOf="@+id/buttonHeight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/titleGuideline"
            app:layout_constraintVertical_bias="0.0" />

        <RadioGroup
            app:layout_constraintTop_toBottomOf="@+id/popup_title"
            app:layout_constraintBottom_toTopOf="@id/branch_number"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:id="@+id/buttons"
            android:weightSum="1.5"
            android:gravity="right">




            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.75"
                android:text="Checking"
                android:textColor="@color/grey"
                android:button="@drawable/checkbox_selector"
                android:buttonTint="@color/grey"
                style="@style/CustomCheckboxCircular"
                android:gravity="center"
                android:id="@+id/checking"
                />
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.75"
                android:text="Saving"
                android:textColor="@color/grey"
                android:button="@drawable/checkbox_selector"
                android:buttonTint="@color/grey"
                style="@style/CustomCheckboxCircular"
                android:gravity="center"
                android:id="@+id/saving"
                />

        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/branch_number"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"

            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toTopOf="@+id/transit_number"
            app:layout_constraintEnd_toEndOf="parent"
            android:hint="Branch Number (5 digits)"
            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintTop_toBottomOf="@+id/buttons">

            <com.google.android.material.textfield.TextInputEditText
                android:paddingVertical="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/input_text_branch_number"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/transit_number"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"

            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toTopOf="@+id/account_number"
            app:layout_constraintEnd_toEndOf="parent"
            android:hint="Transit Number (3 digits)"
            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintTop_toBottomOf="@+id/branch_number">

            <com.google.android.material.textfield.TextInputEditText
                android:paddingVertical="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/input_text_transit_number"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/account_number"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"

            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toTopOf="@+id/name"
            app:layout_constraintEnd_toEndOf="parent"
            android:hint="Account Number (7 digits)"
            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintTop_toBottomOf="@+id/transit_number">

            <com.google.android.material.textfield.TextInputEditText
                android:paddingVertical="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/input_text_account_number"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/name"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"

        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonHeight"
        app:layout_constraintEnd_toEndOf="parent"
        android:hint="账户持有者姓名"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@+id/account_number">

        <com.google.android.material.textfield.TextInputEditText
            android:paddingVertical="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/input_text_name"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>



        <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"
            android:orientation="vertical"
            android:id="@+id/vertMidline"/>

        <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="50dp"
            android:orientation="horizontal"
            android:id="@+id/buttonHeight"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/vertMidline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@id/buttonHeight"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            android:backgroundTint="@color/grey"
            android:textColor="@color/white"
            android:text="取消"
            android:id="@+id/cancel_button"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="@id/vertMidline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@id/buttonHeight"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            android:backgroundTint="@color/yellow"
            android:textColor="@color/black"
            android:text="确认"
            android:id="@+id/confirm_button"
            />





    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>