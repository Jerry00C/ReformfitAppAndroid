<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    app:cardBackgroundColor="@color/white_background"
    app:cardCornerRadius="10dp">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/titleGuideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="20dp" />

                <TextView
                    android:id="@+id/popup_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="70dp"
                    android:text="(新用户注册)"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/titleGuideline"
                    app:layout_constraintVertical_bias="0.014" />





                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/vertMidline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/buttonHeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_end="50dp"
                    app:layout_constraintTop_toBottomOf="@id/postal_warning"
                    tools:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_button"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:backgroundTint="@color/grey"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="取消"
                    android:textColor="@color/white"
                    app:cornerRadius="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/vertMidline"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/buttonHeight" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirm_button"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:backgroundTint="@color/yellow"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="确认"
                    android:textColor="@color/black"
                    app:cornerRadius="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/vertMidline"
                    app:layout_constraintTop_toTopOf="@id/buttonHeight" />

                <TextView
                    android:id="@+id/star1"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:text="*"
                    android:textColor="@color/red"
                    app:layout_constraintBottom_toBottomOf="@+id/textView46"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toTopOf="@+id/textView46" />

                <TextView
                    android:id="@+id/textView46"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Credit Card:"
                    android:paddingVertical="5dp"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/input_text_credit_card"
                    app:layout_constraintStart_toEndOf="@+id/star1"
                    app:layout_constraintTop_toTopOf="@+id/input_text_credit_card" />

                <EditText
                    android:id="@+id/input_text_credit_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/null_drawable"
                    android:ems="10"
                    android:gravity="right"
                    android:hint="请输入信用卡号"
                    android:inputType="number"
                    android:paddingVertical="5dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@+id/textView46"
                    app:layout_constraintTop_toBottomOf="@+id/popup_title" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline57"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.04"/>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline58"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.96"
                    />


                <EditText
                    android:id="@+id/input_text_postal_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/null_drawable"
                    android:ems="10"
                    android:gravity="right"
                    android:hint="请输入邮编"
                    android:inputType="textPostalAddress"
                    android:paddingVertical="5dp"
                    app:layout_constraintBottom_toTopOf="@id/buttonHeight"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@+id/textView60"
                    app:layout_constraintTop_toBottomOf="@+id/province_warning"
                    app:layout_constraintVertical_bias="0.0" />

                <EditText
                    android:id="@+id/input_text_date_valid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/null_drawable"
                    android:ems="10"
                    android:gravity="right"
                    android:hint="请输入年份"
                    android:inputType="date"
                    android:paddingVertical="5dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toEndOf="@+id/textView47"
                    app:layout_constraintTop_toBottomOf="@+id/card_number_warning" />

                <EditText
                    android:id="@+id/input_text_cvv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/null_drawable"
                    android:ems="10"
                    android:gravity="right"
                    android:hint="请输入月份"
                    android:inputType="date"
                    android:paddingVertical="5dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toEndOf="@+id/textView48"
                    app:layout_constraintTop_toBottomOf="@+id/year_warning" />

                <Spinner
                    android:id="@+id/input_text_line_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintHorizontal_bias="1.0"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toEndOf="@+id/textView53"
                    app:layout_constraintTop_toBottomOf="@+id/address_warning" />



                <EditText
                    android:id="@+id/input_text_city"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/null_drawable"
                    android:ems="10"
                    android:gravity="right"
                    android:hint="请输入城市"
                    android:inputType="text"
                    android:paddingVertical="5dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toEndOf="@+id/textView57"
                    app:layout_constraintTop_toBottomOf="@+id/card_type_warning" />

                <EditText
                    android:id="@+id/input_text_province"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/null_drawable"
                    android:ems="10"
                    android:gravity="right"
                    android:hint="请输入省份"
                    android:inputType="textPostalAddress"
                    android:paddingVertical="5dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toEndOf="@+id/textView59"
                    app:layout_constraintTop_toBottomOf="@+id/city_warning" />

                <EditText
                    android:id="@+id/input_text_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/null_drawable"
                    android:ems="10"
                    android:gravity="right"
                    android:hint="请输入姓"
                    android:inputType="textPersonName"
                    android:paddingVertical="5dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toEndOf="@+id/textView49"
                    app:layout_constraintTop_toBottomOf="@+id/month_warning" />

                <TextView
                    android:id="@+id/star2"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:text="*"
                    android:textColor="@color/red"
                    app:layout_constraintBottom_toBottomOf="@+id/textView47"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toTopOf="@+id/textView47" />






                <TextView
                    android:id="@+id/textView47"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Year: "
                    android:paddingVertical="5dp"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/input_text_date_valid"
                    app:layout_constraintStart_toEndOf="@+id/star2"
                    app:layout_constraintTop_toTopOf="@+id/input_text_date_valid" />

                <TextView
                    android:id="@+id/star3"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:text="*"
                    android:textColor="@color/red"
                    app:layout_constraintBottom_toBottomOf="@+id/textView48"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toTopOf="@+id/textView48" />

                <TextView
                    android:id="@+id/textView48"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Month: "
                    android:paddingVertical="5dp"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/input_text_cvv"
                    app:layout_constraintStart_toEndOf="@+id/star3"
                    app:layout_constraintTop_toTopOf="@+id/input_text_cvv" />


                <TextView
                    android:id="@+id/star4"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:text="*"
                    android:textColor="@color/red"
                    app:layout_constraintBottom_toBottomOf="@+id/textView49"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toTopOf="@+id/textView49" />




                <TextView
                    android:id="@+id/textView49"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:textColor="@color/black"
                    android:text="Name: "
                    android:paddingVertical="5dp"
                    app:layout_constraintBottom_toBottomOf="@+id/input_text_name"
                    app:layout_constraintStart_toEndOf="@+id/star4"
                    app:layout_constraintTop_toTopOf="@+id/input_text_name" />

                <TextView
                    android:id="@+id/star5"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:text="*"
                    android:textColor="@color/red"
                    app:layout_constraintBottom_toBottomOf="@+id/textView61"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toTopOf="@+id/textView61" />



                <TextView
                    android:id="@+id/star6"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:text="*"
                    android:textColor="@color/red"
                    app:layout_constraintBottom_toBottomOf="@+id/textView53"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toTopOf="@+id/textView53" />



                <TextView
                    android:id="@+id/textView53"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Card Type:  "
                    android:textColor="@color/black"
                    android:paddingVertical="5dp"
                    app:layout_constraintBottom_toBottomOf="@+id/input_text_line_2"
                    app:layout_constraintStart_toEndOf="@+id/star6"
                    app:layout_constraintTop_toTopOf="@+id/input_text_line_2" />

                <TextView
                    android:id="@+id/star7"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:text="*"
                    android:textColor="@color/red"
                    app:layout_constraintBottom_toBottomOf="@+id/textView57"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toTopOf="@+id/textView57" />






                <TextView
                    android:id="@+id/textView57"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="City: "
                    android:textColor="@color/black"
                    android:paddingVertical="5dp"
                    app:layout_constraintBottom_toBottomOf="@+id/input_text_city"
                    app:layout_constraintStart_toEndOf="@+id/star7"
                    app:layout_constraintTop_toTopOf="@+id/input_text_city" />


                <TextView
                    android:id="@+id/star8"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:text="*"
                    android:textColor="@color/red"
                    app:layout_constraintBottom_toBottomOf="@+id/textView59"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toTopOf="@+id/textView59" />



                <TextView
                    android:id="@+id/textView59"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:paddingVertical="5dp"
                    android:text="Province："
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/input_text_province"
                    app:layout_constraintStart_toEndOf="@+id/star8"
                    app:layout_constraintTop_toTopOf="@+id/input_text_province"
                    app:layout_constraintVertical_bias="0.0" />


                <TextView
                    android:id="@+id/star9"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:text="*"
                    android:textColor="@color/red"
                    app:layout_constraintBottom_toBottomOf="@+id/textView60"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toTopOf="@+id/textView60" />









                <TextView
                    android:id="@+id/textView60"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="邮编: "
                    android:textColor="@color/black"
                    android:paddingVertical="5dp"
                    app:layout_constraintBottom_toBottomOf="@+id/input_text_postal_code"
                    app:layout_constraintStart_toEndOf="@+id/star9"
                    app:layout_constraintTop_toTopOf="@+id/input_text_postal_code" />


                <View
                    android:id="@+id/view3"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_credit_card" />

                <View
                    android:id="@+id/view4"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_date_valid" />

                <View
                    android:id="@+id/view5"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_cvv" />

                <View
                    android:id="@+id/view6"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_name" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_line_2" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_city" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_province" />

                <View
                    android:id="@+id/view17"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_postal_code" />


                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/guideline57"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_address" />

                <TextView
                    android:id="@+id/textView61"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="Billing address "
                    android:paddingVertical="5dp"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/input_text_address"
                    app:layout_constraintStart_toEndOf="@+id/star5"
                    app:layout_constraintTop_toTopOf="@+id/input_text_address" />

                <EditText
                    android:id="@+id/input_text_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/null_drawable"
                    android:ems="10"
                    android:gravity="right"
                    android:hint="请输入地址"
                    android:inputType="textPostalAddress"
                    android:paddingVertical="5dp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintStart_toEndOf="@+id/textView61"
                    app:layout_constraintTop_toBottomOf="@+id/name_warning" />

                <TextView
                    android:id="@+id/card_number_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TextView"
                    android:textColor="@color/red"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_credit_card" />

                <TextView
                    android:id="@+id/year_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TextView"
                    android:textColor="@color/red"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintTop_toBottomOf="@+id/view4" />

                <TextView
                    android:id="@+id/month_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TextView"
                    android:textColor="@color/red"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_cvv" />

                <TextView
                    android:id="@+id/name_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TextView"
                    android:textColor="@color/red"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_name" />

                <TextView
                    android:id="@+id/address_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TextView"
                    android:textColor="@color/red"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_address" />

                <TextView
                    android:id="@+id/card_type_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TextView"
                    android:textColor="@color/red"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_line_2" />

                <TextView
                    android:id="@+id/city_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TextView"
                    android:textColor="@color/red"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_city" />

                <TextView
                    android:id="@+id/province_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TextView"
                    android:textColor="@color/red"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_province" />

                <TextView
                    android:id="@+id/postal_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="TextView"
                    android:textColor="@color/red"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@id/buttonHeight"
                    app:layout_constraintEnd_toStartOf="@+id/guideline58"
                    app:layout_constraintTop_toBottomOf="@+id/input_text_postal_code" />


            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>




    </ScrollView>
</com.google.android.material.card.MaterialCardView>