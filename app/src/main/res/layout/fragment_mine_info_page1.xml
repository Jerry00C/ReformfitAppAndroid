<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MineInfoPage1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/black3"
            app:cardCornerRadius="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingVertical="10dp">



                <TextView
                    android:id="@+id/textView25"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="我的设备"
                    android:textColor="@color/yellow"
                    app:layout_constraintStart_toStartOf="@+id/guideline39"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.navigation.NavigationView
                    android:id="@+id/divider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:fitsSystemWindows="true"
                    android:theme="@style/Theme.ReformfitApp.NavigationView"
                    app:itemIconTint="@color/grey"
                    app:itemTextColor="@color/grey"
                    app:layout_constraintEnd_toStartOf="@+id/guideline42"
                    app:layout_constraintStart_toStartOf="@+id/guideline39"
                    app:layout_constraintTop_toBottomOf="@+id/textView25" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline39"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.04" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline42"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.96" />

                <TextView
                    android:id="@+id/textView27"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="手环品牌："
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="@+id/guideline39"
                    app:layout_constraintTop_toBottomOf="@+id/divider" />


                <TextView
                    android:id="@+id/wristbandBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    app:layout_constraintBottom_toBottomOf="@+id/textView27"
                    app:layout_constraintEnd_toStartOf="@+id/guideline42"
                    app:layout_constraintTop_toTopOf="@+id/textView27" />

                <TextView
                    android:id="@+id/textView30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="手环号码："
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="@+id/guideline39"
                    app:layout_constraintTop_toBottomOf="@+id/textView27" />


                <ImageView
                    android:id="@+id/init_wristbandNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/down_arrow"
                    app:layout_constraintBottom_toBottomOf="@+id/textView30"
                    app:layout_constraintEnd_toStartOf="@+id/guideline42"
                    app:layout_constraintTop_toTopOf="@+id/textView30" />



                <TextView
                    android:id="@+id/wristbandNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    app:layout_constraintBottom_toBottomOf="@+id/init_wristbandNum"
                    app:layout_constraintEnd_toStartOf="@+id/init_wristbandNum"
                    app:layout_constraintTop_toTopOf="@+id/init_wristbandNum" />


                <ProgressBar
                    android:id="@+id/progressBarNum"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/yellow"
                    android:indeterminateTintMode="src_atop"
                    app:layout_constraintBottom_toBottomOf="@+id/wristbandNum"
                    app:layout_constraintEnd_toStartOf="@+id/wristbandNum"
                    app:layout_constraintTop_toTopOf="@+id/wristbandNum"
                    android:visibility="invisible"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/black3"
            app:cardCornerRadius="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingVertical="10dp">


                <androidx.gridlayout.widget.GridLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    app:columnCount="4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:rowCount="4">


                    <ImageView
                        android:paddingTop="3dp"
                        android:src="@drawable/burn_group_service"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_row="0"
                        android:id="@+id/health_image"/>

                    <ImageView
                        android:paddingTop="3dp"
                        android:src="@drawable/burn_group_service"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_row="0"

                        />

                    <ImageView
                        android:paddingTop="3dp"
                        android:src="@drawable/burn_group_service"
                        app:layout_column="2"
                        app:layout_columnWeight="1"
                        app:layout_row="0"
                        android:id="@+id/diet_image"

                        />

                    <ImageView
                        android:paddingTop="3dp"
                        android:src="@drawable/burn_group_service"
                        app:layout_column="3"
                        app:layout_columnWeight="1"
                        app:layout_row="0"
                        android:id="@+id/BMI_image"

                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/image1"
                        android:paddingBottom="8dp"
                        android:text="体测数据"
                        android:id="@+id/health_text"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_gravity="center"
                        app:layout_row="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/image1"
                        android:text="更衣室"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_gravity="center"
                        app:layout_row="1" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/image1"
                        android:text="健康配餐"
                        android:id="@+id/diet_text"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        app:layout_column="2"
                        app:layout_columnWeight="1"
                        app:layout_gravity="center"
                        app:layout_row="1"
                        />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/image1"
                        android:text="BMI计算"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        app:layout_column="3"
                        app:layout_columnWeight="1"
                        app:layout_gravity="center"
                        app:layout_row="1"
                        android:id="@+id/BMI_text"
                        android:clickable="true"/>


                    <ImageView
                        android:paddingTop="3dp"
                        android:src="@drawable/ic_enter_purchase_page"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_row="2"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:id="@+id/purchase_image"

                        />

                    <ImageView
                        android:paddingTop="3dp"
                        android:src="@drawable/burn_group_service"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_row="2"
                        android:id="@+id/blog_image"

                        />

                    <ImageView
                        android:paddingTop="3dp"
                        android:src="@drawable/burn_group_service"
                        app:layout_column="2"
                        app:layout_columnWeight="1"
                        app:layout_row="2"
                        android:id="@+id/bmr_image"

                        />

                    <ImageView
                        android:paddingTop="3dp"
                        android:src="@drawable/burn_group_service"
                        app:layout_column="3"
                        app:layout_columnWeight="1"
                        app:layout_row="2"
                        android:id="@+id/tdee_image"

                        />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/image1"
                        android:text="购买课包"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_gravity="center"
                        app:layout_row="3"
                        android:id="@+id/purchase_text"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/image1"
                        android:text="最新Blog"
                        android:id="@+id/blog_text"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_gravity="center"
                        app:layout_row="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/image1"
                        android:text="BMR计算"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        app:layout_column="2"
                        app:layout_columnWeight="1"
                        app:layout_gravity="center"
                        app:layout_row="3"
                        android:id="@+id/bmr_text"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/image1"
                        android:text="TDEE计算"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        app:layout_column="3"
                        app:layout_columnWeight="1"
                        app:layout_gravity="center"
                        app:layout_row="3"
                        android:id="@+id/tdee_text"/>


                </androidx.gridlayout.widget.GridLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


    </LinearLayout>

</FrameLayout>