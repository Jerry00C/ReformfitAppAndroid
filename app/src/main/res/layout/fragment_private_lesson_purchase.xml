                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/plp_1on1_title"
                            android:textColor="@color/yellow"
                            android:textSize="18sp"
                            app:layout_constraintBottom_toBottomOf="@+id/one_on_one_private_icon"

                            app:layout_constraintStart_toEndOf="@id/one_on_one_private_icon"
                            app:layout_constraintTop_toTopOf="@+id/one_on_one_private_icon" />

                        <View
