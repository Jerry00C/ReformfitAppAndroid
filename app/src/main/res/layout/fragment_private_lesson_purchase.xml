                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/info_icon_1_1"
                            app:layout_constraintStart_toEndOf="@id/info_icon_1_1"
                            app:layout_constraintTop_toTopOf="@+id/info_icon_1_1" />

                        <ImageView
                            android:id="@+id/info_icon_1_2"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="12dp"
                            android:src="@drawable/ic_info_icon_2"
