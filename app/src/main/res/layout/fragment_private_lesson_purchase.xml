                        <ImageView
                            android:id="@+id/proceedIcon2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_purchase_proceed"
                            app:layout_constraintBottom_toBottomOf="@+id/one_on_one_option2_price"
                            app:layout_constraintEnd_toEndOf="@id/vertGuideline1_2"
                            app:layout_constraintTop_toTopOf="@+id/one_on_one_option2_price"
                            />

