                            app:layout_constraintBottom_toBottomOf="@id/info_icon_3_2"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/one_on_one_option3"/>


                        <TextView
                            android:id="@+id/one_on_one_option3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/plp_1on1_option3"
                            android:textColor="#DEDEDE"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="@id/vertGuideline1_1"
                            app:layout_constraintTop_toBottomOf="@id/info_icon_2_2" />

                        <ImageView
                            android:id="@+id/info_icon_3_1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="16dp"
                            android:src="@drawable/ic_info_icon_2"
                            app:layout_constraintStart_toStartOf="@id/vertGuideline1_1"
                            app:layout_constraintTop_toBottomOf="@id/one_on_one_option3" />

                        <TextView
                            android:id="@+id/purchase_info_3_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/plp_1on1_info_3_1"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/info_icon_3_1"
                            app:layout_constraintStart_toEndOf="@id/info_icon_3_1"
                            app:layout_constraintTop_toTopOf="@+id/info_icon_3_1" />

                        <ImageView
                            android:id="@+id/info_icon_3_2"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="12dp"
                            android:src="@drawable/ic_info_icon_2"
                            app:layout_constraintStart_toStartOf="@id/vertGuideline1_1"
                            app:layout_constraintTop_toBottomOf="@id/info_icon_3_1" />

                        <TextView
                            android:id="@+id/purchase_info_3_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/plp_1on1_info_3_2"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@+id/info_icon_3_2"
                            app:layout_constraintStart_toEndOf="@id/info_icon_3_2"
                            app:layout_constraintTop_toTopOf="@id/info_icon_3_2" />

                        <TextView
