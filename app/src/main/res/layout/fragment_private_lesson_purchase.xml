                            app:layout_constraintTop_toBottomOf="@id/info_icon_1_1" />

                        <TextView
                            android:id="@+id/purchase_info_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/plp_1on1_info_1_2"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@+id/info_icon_1_2"
                            app:layout_constraintStart_toEndOf="@id/info_icon_1_2"
                            app:layout_constraintTop_toTopOf="@id/info_icon_1_2" />

                        <TextView
