<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#242424"
    app:cardCornerRadius="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="12dp">


        <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/vertGuideline4_1"
            app:layout_constraintGuide_percent="0.04"
            />
        <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/vertGuideline4_2"
            app:layout_constraintGuide_percent="0.96"
            />

        <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/horGuideline4_1"
            app:layout_constraintGuide_begin="0dp"
            />


        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:src="@drawable/ic_agreement"
            app:layout_constraintEnd_toStartOf="@+id/vertGuideline4_2"

            app:layout_constraintTop_toTopOf="@+id/payment_method"
            app:layout_constraintBottom_toBottomOf="@id/payment_method"
            android:id="@+id/payment_modifier"/>

        <TextView
            android:id="@+id/payment_method"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="付款方式"
            android:textColor="@color/yellow"
            android:textSize="18sp"

            app:layout_constraintHorizontal_bias="0.07"
            app:layout_constraintStart_toEndOf="@id/vertGuideline4_1"

            app:layout_constraintTop_toTopOf="@+id/horGuideline4_1" />



        <View
            android:id="@+id/divider1_2"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/grey"
            app:layout_constraintStart_toStartOf="@id/vertGuideline4_1"
            app:layout_constraintEnd_toEndOf="@id/vertGuideline4_2"
            app:layout_constraintTop_toBottomOf="@id/payment_method"
            android:layout_marginTop="12dp"
            />

        <TextView
            android:id="@+id/info_third"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:textColor="#DEDEDE"
            android:textSize="16sp"
            android:text="Branch Number:"

            app:layout_constraintTop_toBottomOf="@id/divider1_2"
            app:layout_constraintStart_toStartOf="@id/vertGuideline4_1"
            android:layout_marginTop="12dp"
            />

        <TextView
            android:id="@+id/info_third_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@+id/info_third"
            app:layout_constraintBottom_toBottomOf="@id/info_third"
            app:layout_constraintEnd_toStartOf="@id/vertGuideline4_2"
            android:text=""
            android:textColor="#DEDEDE"
            android:textSize="14dp"
            />
        <TextView
            android:id="@+id/info_fourth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:textColor="#DEDEDE"
            android:textSize="16sp"
            android:text="Transit Number:"

            app:layout_constraintTop_toBottomOf="@id/info_third"
            app:layout_constraintStart_toStartOf="@id/vertGuideline4_1"
            android:layout_marginTop="12dp"
            />

        <TextView
            android:id="@+id/info_fourth_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@+id/info_fourth"
            app:layout_constraintBottom_toBottomOf="@id/info_fourth"
            app:layout_constraintEnd_toStartOf="@id/vertGuideline4_2"
            android:text=""
            android:textColor="#DEDEDE"
            android:textSize="14dp"
            />

        <TextView
            android:id="@+id/info_fifth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:textColor="#DEDEDE"
            android:textSize="16sp"
            android:text="Account Number:"

            app:layout_constraintTop_toBottomOf="@id/info_fourth"
            app:layout_constraintStart_toStartOf="@id/vertGuideline4_1"
            android:layout_marginTop="12dp"
            />

        <TextView
            android:id="@+id/info_fifth_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@+id/info_fifth"
            app:layout_constraintBottom_toBottomOf="@id/info_fifth"
            app:layout_constraintEnd_toStartOf="@id/vertGuideline4_2"
            android:text=""
            android:textColor="#DEDEDE"
            android:textSize="14dp"
            />


















    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>