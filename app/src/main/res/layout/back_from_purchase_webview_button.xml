<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="80dp"
    android:layout_height="30dp"
    android:background="@drawable/top_navi_component"

    >



    <ImageView
        android:id="@+id/init_home"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_purchase_proceed"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent "
        android:rotation="180"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Go back"
        android:textColor="@color/yellow"
        app:layout_constraintStart_toEndOf="@id/init_home"
        app:layout_constraintTop_toTopOf="@id/init_home"
        app:layout_constraintBottom_toBottomOf="@id/init_home"
        android:textSize="12sp"
        />







</androidx.constraintlayout.widget.ConstraintLayout>