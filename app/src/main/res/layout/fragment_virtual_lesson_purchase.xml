<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".purchaseFragment.VirtualLessonFragmentPurchase">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">




            <ImageView
                android:id="@+id/topImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_launcher" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="18dp">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/vertGuideline1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.04" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/vertGuideline2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.96
" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardView4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#242424"
                    app:cardCornerRadius="10dp"
                    app:layout_constraintEnd_toEndOf="@id/vertGuideline2"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/vertGuideline1"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingVertical="12dp">


                        <androidx.constraintlayout.widget.Guideline
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:id="@+id/vertGuideline1_1"
                            app:layout_constraintGuide_percent="0.04"
                            />
                        <androidx.constraintlayout.widget.Guideline
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:id="@+id/vertGuideline1_2"
                            app:layout_constraintGuide_percent="0.96"
                            />

                        <androidx.constraintlayout.widget.Guideline
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:id="@+id/horGuideline1_1"
                            app:layout_constraintGuide_begin="0dp"
                            />

                        <View
                            android:id="@+id/virtual_unlimited_clickable"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="@id/info_icon_1_3"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/virtual_unlimited_title"/>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_purchase_option"
                            app:layout_constraintStart_toStartOf="@+id/vertGuideline1_1"
                            app:layout_constraintTop_toTopOf="@+id/horGuideline1_1"
                            android:id="@+id/one_on_one_private_icon"/>

                        <TextView
                            android:id="@+id/payment_method"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1-1私教套餐"
                            android:textColor="@color/yellow"
                            android:textSize="18sp"
                            app:layout_constraintBottom_toBottomOf="@+id/one_on_one_private_icon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.07"
                            app:layout_constraintStart_toEndOf="@id/one_on_one_private_icon"

                            app:layout_constraintTop_toTopOf="@+id/one_on_one_private_icon" />

                        <View
                            android:id="@+id/divider"
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:background="@color/grey"
                            app:layout_constraintStart_toStartOf="@id/one_on_one_private_icon"
                            app:layout_constraintEnd_toEndOf="@id/vertGuideline1_2"
                            app:layout_constraintTop_toBottomOf="@id/one_on_one_private_icon"
                            android:layout_marginTop="12dp"
                            />

                        <TextView
                            android:id="@+id/virtual_unlimited_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Premier BURN!"
                            android:textColor="#DEDEDE"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/divider"
                            app:layout_constraintStart_toStartOf="@id/vertGuideline1_1"
                            android:layout_marginTop="12dp"/>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_info_icon_2"
                            app:layout_constraintStart_toStartOf="@id/vertGuideline1_1"
                            app:layout_constraintTop_toBottomOf="@id/virtual_unlimited_title"
                            android:layout_marginTop="12dp"
                            android:id="@+id/info_icon_1_1"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20次店内团课"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/info_icon_1_1"
                            app:layout_constraintStart_toEndOf="@id/info_icon_1_1"
                            app:layout_constraintTop_toTopOf="@+id/info_icon_1_1"
                            android:id="@+id/virtual_unlimited_info_1"/>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_info_icon_2"
                            app:layout_constraintTop_toBottomOf="@id/info_icon_1_1"
                            app:layout_constraintStart_toStartOf="@id/vertGuideline1_1"
                            android:layout_marginTop="6dp"
                            android:id="@+id/info_icon_1_2"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(place holder)"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:layout_constraintTop_toTopOf="@id/info_icon_1_2"
                            app:layout_constraintBottom_toBottomOf="@+id/info_icon_1_2"
                            app:layout_constraintStart_toEndOf="@id/info_icon_1_2"
                            android:id="@+id/virtual_unlimited_info_2"
                            />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_info_icon_2"
                            app:layout_constraintTop_toBottomOf="@id/info_icon_1_2"
                            app:layout_constraintStart_toStartOf="@id/vertGuideline1_1"
                            android:layout_marginTop="6dp"
                            android:id="@+id/info_icon_1_3"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(place holder)"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:layout_constraintTop_toTopOf="@id/info_icon_1_3"
                            app:layout_constraintBottom_toBottomOf="@+id/info_icon_1_3"
                            app:layout_constraintStart_toEndOf="@id/info_icon_1_3"
                            android:id="@+id/virtual_unlimited_info_3"
                            />

                        <TextView
                            android:id="@+id/info_first_display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="@+id/virtual_unlimited_title"
                            app:layout_constraintBottom_toBottomOf="@id/info_icon_1_3"
                            app:layout_constraintEnd_toStartOf="@id/proceedIcon1"
                            android:text="$6500"
                            android:textColor="#DEDEDE"
                            android:textSize="14sp"

                            />

                        <ImageView
                            android:id="@+id/proceedIcon1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_purchase_proceed"
                            app:layout_constraintBottom_toBottomOf="@+id/info_first_display"
                            app:layout_constraintEnd_toEndOf="@id/vertGuideline1_2"
                            app:layout_constraintTop_toTopOf="@+id/info_first_display"
                            app:layout_constraintVertical_bias="0.5" />





                    </androidx.constraintlayout.widget.ConstraintLayout>





                </com.google.android.material.card.MaterialCardView>




            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginVertical="18dp">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/vertGuideline1_outer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.04" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/vertGuideline2_outer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.96
" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardView5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#242424"
                    app:cardCornerRadius="10dp"
                    app:layout_constraintEnd_toEndOf="@id/vertGuideline2_outer"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="@+id/vertGuideline1_outer"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingVertical="12dp">


                        <androidx.constraintlayout.widget.Guideline
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:id="@+id/vertGuideline2_1"
                            app:layout_constraintGuide_percent="0.04"
                            />
                        <androidx.constraintlayout.widget.Guideline
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:id="@+id/vertGuideline2_2"
                            app:layout_constraintGuide_percent="0.96"
                            />

                        <androidx.constraintlayout.widget.Guideline
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:id="@+id/horGuideline2_1"
                            app:layout_constraintGuide_begin="0dp"
                            />

                        <View
                            android:id="@+id/virtual_10_clickable"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="@id/info_icon_5_1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/virtual_10_title"/>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_purchase_option"
                            app:layout_constraintStart_toStartOf="@+id/vertGuideline2_1"
                            app:layout_constraintTop_toTopOf="@+id/horGuideline2_1"
                            android:id="@+id/comp_prep_icon"/>

                        <TextView
                            android:id="@+id/comp_prep_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1-1私教套餐"
                            android:textColor="@color/yellow"
                            android:textSize="18sp"
                            app:layout_constraintBottom_toBottomOf="@+id/comp_prep_icon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.07"
                            app:layout_constraintStart_toEndOf="@id/comp_prep_icon"

                            app:layout_constraintTop_toTopOf="@+id/comp_prep_icon" />

                        <View
                            android:id="@+id/divide2"
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:background="@color/grey"
                            app:layout_constraintStart_toStartOf="@id/comp_prep_icon"
                            app:layout_constraintEnd_toEndOf="@id/vertGuideline2_2"
                            app:layout_constraintTop_toBottomOf="@id/comp_prep_icon"
                            android:layout_marginTop="12dp"
                            />

                        <TextView
                            android:id="@+id/virtual_10_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Premier BURN!"
                            android:textColor="#DEDEDE"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/divide2"
                            app:layout_constraintStart_toStartOf="@id/vertGuideline2_1"
                            android:layout_marginTop="12dp"/>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_info_icon_2"
                            app:layout_constraintStart_toStartOf="@id/vertGuideline2_1"
                            app:layout_constraintTop_toBottomOf="@id/virtual_10_title"
                            android:layout_marginTop="12dp"
                            android:id="@+id/info_icon_5_1"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20次店内团课"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/info_icon_5_1"
                            app:layout_constraintStart_toEndOf="@id/info_icon_5_1"
                            app:layout_constraintTop_toTopOf="@+id/info_icon_5_1"
                            android:id="@+id/virtual_10_info_1"/>





                        <TextView
                            android:id="@+id/comp_prep_option1_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="@+id/virtual_10_title"
                            app:layout_constraintBottom_toBottomOf="@id/info_icon_5_1"
                            app:layout_constraintEnd_toStartOf="@id/proceedIcon5"
                            android:text="$6500"
                            android:textColor="#DEDEDE"
                            android:textSize="14sp"

                            />

                        <ImageView
                            android:id="@+id/proceedIcon5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_purchase_proceed"
                            app:layout_constraintBottom_toBottomOf="@+id/comp_prep_option1_price"
                            app:layout_constraintEnd_toEndOf="@id/vertGuideline2_2"
                            app:layout_constraintTop_toTopOf="@+id/comp_prep_option1_price"
                            app:layout_constraintVertical_bias="0.5" />

                        <View
                            android:id="@+id/virtual_5_clickable"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="@id/info_icon_6_1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/virtual_5_title"/>


                        <TextView
                            android:id="@+id/virtual_5_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Premier BURN!"
                            android:textColor="#DEDEDE"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/info_icon_5_1"
                            app:layout_constraintStart_toStartOf="@id/vertGuideline2_1"
                            android:layout_marginTop="12dp"/>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_info_icon_2"
                            app:layout_constraintStart_toStartOf="@id/vertGuideline2_1"
                            app:layout_constraintTop_toBottomOf="@id/virtual_5_title"
                            android:layout_marginTop="12dp"
                            android:id="@+id/info_icon_6_1"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20次店内团课"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/info_icon_6_1"
                            app:layout_constraintStart_toEndOf="@id/info_icon_6_1"
                            app:layout_constraintTop_toTopOf="@+id/info_icon_6_1"
                            android:id="@+id/virtual_5_info_1"/>




                        <TextView
                            android:id="@+id/comp_prep_option2_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="@+id/virtual_5_title"
                            app:layout_constraintBottom_toBottomOf="@id/info_icon_6_1"
                            app:layout_constraintEnd_toStartOf="@id/proceedIcon6"
                            android:text="$6500"
                            android:textColor="#DEDEDE"
                            android:textSize="14sp"

                            />

                        <ImageView
                            android:id="@+id/proceedIcon6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_purchase_proceed"
                            app:layout_constraintBottom_toBottomOf="@+id/comp_prep_option2_price"
                            app:layout_constraintEnd_toEndOf="@id/vertGuideline2_2"
                            app:layout_constraintTop_toTopOf="@+id/comp_prep_option2_price"
                            />


                    </androidx.constraintlayout.widget.ConstraintLayout>





                </com.google.android.material.card.MaterialCardView>




            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>



    </ScrollView>


</FrameLayout>